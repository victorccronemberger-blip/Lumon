:root {
  --space: #111a26;
  --panel: #20373c;
  --inner: #2e4649;
  --line: #49545c;
  --paper: #ebe1ce;
  --muted: #b4bcc1;
  --bronze: #bd9564;
  --gold: #f5d7a2;
  --jade: #91c1bb;
}

* { color: var(--paper); }
.hub-root, .full { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.is-hidden { display: none; }
.display-title { -unity-font-definition: url("project://database/Assets/Resources/Lumon/Fonts/SourceSerif4-Semibold.asset"); }
.body-font { -unity-font-definition: url("project://database/Assets/Resources/Lumon/Fonts/AtkinsonHyperlegible-Regular.asset"); }
.pixel-title { -unity-font-style: bold; }

.brand-mark > *, .currency-glyph > *, .station-emblem > *, .marker-glyph > *, .icon-button > * { width: 100%; height: 100%; }
.top-hud { position: absolute; left: 28px; right: 28px; top: 23px; height: 68px; flex-direction: row; align-items: center; justify-content: space-between; }
.brand { background-color: rgba(29,48,53,0.92); flex-direction: row; align-items: center; padding: 3px 11px 7px 0; border-bottom-width: 1px; border-color: var(--bronze); }
.brand-mark { width: 42px; height: 42px; border-width: 1px; border-color: var(--bronze); background-color: rgba(24,34,47,0.85); margin-right: 11px; }
.brand-name { font-size: 35px; color: var(--paper); margin: -5px 0 0; }
.brand-sub { font-size: 12px; letter-spacing: 2.8px; color: var(--gold); margin: -2px 0 0; }
.hud-right { flex-direction: row; align-items: center; }
.currency { height: 42px; flex-direction: row; align-items: center; background-color: rgba(17,26,38,0.92); border-width: 1px; border-color: var(--bronze); padding: 0 14px 0 8px; margin-right: 8px; }
.currency-glyph { width: 26px; height: 26px; margin-right: 5px; }
.currency-text { color: var(--paper); font-size: 19px; -unity-font-style: bold; }
.icon-button { width: 42px; height: 42px; background-color: var(--panel); border-width: 1px; border-color: var(--bronze); border-radius: 0; margin: 0; padding: 7px; }
.icon-button:hover, .icon-button:focus { background-color: var(--inner); border-color: var(--gold); }

.marker-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.station-marker { position: absolute; margin: 0; flex-direction: row; align-items: center; justify-content: center; background-color: rgba(31,51,56,0.91); border-width: 1px; border-color: #7d715f; border-radius: 0; padding: 0 4px; }
.station-marker:hover, .station-marker:focus { background-color: var(--inner); border-color: var(--gold); }
.station-marker.is-near { background-color: #253e48; border-color: var(--jade); }
.marker-glyph { width: 17px; height: 17px; margin-right: 3px; flex-shrink: 0; }
.marker-label { margin: 0; padding: 0; font-size: 12px; letter-spacing: 0.45px; color: var(--paper); }

.prompt { position: absolute; left: 50%; bottom: 26px; width: 354px; margin-left: -177px; flex-direction: row; align-items: center; justify-content: center; background-color: rgba(17,26,38,0.96); border-width: 1px; border-color: var(--jade); padding: 6px 12px; }
.key { min-width: 32px; height: 31px; margin-right: 10px; background-color: var(--inner); border-width: 1px; border-color: var(--bronze); color: var(--gold); font-size: 18px; -unity-text-align: middle-center; }
.prompt-text { font-size: 17px; }
.controls { background-color: rgba(17,26,38,0.87); position: absolute; left: 28px; bottom: 22px; color: var(--muted); padding: 4px 8px; font-size: 13px; border-left-width: 1px; border-color: var(--bronze); }

.modal-host { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
.modal-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(8,14,24,0.70); }
.panel-shadow { width: 884px; height: 556px; background-color: var(--space); padding: 5px; }
.station-panel { flex-grow: 1; background-color: var(--panel); border-width: 1px; border-color: var(--bronze); }
.station-header { height: 87px; flex-direction: row; align-items: center; border-bottom-width: 1px; border-color: var(--bronze); padding: 12px 24px; }
.station-emblem { width: 47px; height: 47px; background-color: var(--inner); border-width: 1px; border-color: var(--bronze); margin-right: 15px; padding: 6px; }
.station-kicker { font-size: 12px; color: var(--gold); letter-spacing: 2px; margin: 0; }
.station-title { font-size: 37px; color: var(--paper); margin: -3px 0 0; }
.close-button { position: absolute; right: 23px; top: 24px; width: 37px; height: 37px; font-size: 23px; background-color: var(--inner); color: var(--paper); border-width: 1px; border-color: var(--line); border-radius: 0; }
.close-button:hover, .close-button:focus { border-color: var(--gold); color: var(--gold); }
.station-scroll { flex-grow: 1; margin: 15px 25px 2px; }
.station-scroll .unity-scroller--vertical { width: 8px; min-width: 8px; max-width: 8px; margin-left: 7px; }
.station-scroll .unity-scroller__low-button, .station-scroll .unity-scroller__high-button { display: none; }
.station-scroll .unity-scroller__slider, .station-scroll .unity-base-slider__input { min-width: 0; max-width: 8px; }
.station-scroll .unity-base-slider__tracker { background-color: var(--space); border-width: 1px; border-color: var(--line); }
.station-scroll .unity-base-slider__dragger { background-color: #726551; border-width: 0; border-radius: 0; }
.station-scroll .unity-base-slider__dragger:hover { background-color: var(--gold); }
.station-body { flex-grow: 1; }
.station-footer { min-height: 38px; margin: 0 25px 5px; border-top-width: 1px; border-color: var(--line); flex-direction: row; align-items: center; justify-content: space-between; }
.station-hint { color: var(--muted); font-size: 13px; flex-grow: 1; white-space: normal; }

.section-title { font-size: 16px; color: var(--gold); letter-spacing: 0.8px; margin-bottom: 6px; }
.body-copy { font-size: 17px; color: var(--muted); white-space: normal; margin-bottom: 10px; }
.pixel-row { min-height: 58px; flex-direction: row; align-items: center; background-color: var(--inner); border-width: 1px; border-color: var(--line); margin-bottom: 7px; padding: 5px 10px; }
.pixel-row:hover, .pixel-row:focus { border-color: var(--gold); }
.pixel-row.is-selected { background-color: #263e46; border-color: #739e9a; }
.row-glyph { width: 40px; height: 40px; margin-right: 12px; background-color: var(--panel); border-width: 1px; border-color: var(--line); padding: 5px; }
.creature-portrait { width: 48px; height: 48px; padding: 0; border-color: var(--bronze); }
.team-layout { flex-direction: row; height: 297px; flex-shrink: 0; }
.team-roster { flex-grow: 1; min-width: 0; margin-right: 12px; }
.team-roster .pixel-row { min-height: 66px; }
.team-showcase { width: 278px; flex-shrink: 0; border-width: 1px; border-color: var(--bronze); background-color: var(--space); }
.team-model { height: 251px; flex-shrink: 0; background-color: #1f2a36; }
.team-caption { flex-grow: 1; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 9px; border-top-width: 1px; border-color: var(--line); }
.turn-model { min-height: 28px; color: var(--paper); background-color: var(--inner); border-width: 1px; border-color: var(--line); margin: 0; padding: 1px 8px; font-size: 12px; -unity-font-style: bold; }
.turn-model:hover, .turn-model:focus { border-color: var(--gold); }
.row-main { flex-grow: 1; }
.row-title { font-size: 17px; color: var(--paper); }
.row-detail { font-size: 12px; color: var(--muted); }
.row-action { min-width: 118px; min-height: 37px; background-color: var(--panel); color: var(--paper); border-width: 1px; border-color: var(--bronze); border-radius: 0; margin: 0; }
.row-action:hover, .row-action:focus { background-color: #384651; border-color: var(--gold); }
.row-action:disabled { color: var(--muted); background-color: var(--panel); border-color: var(--line); }
.action-bar { flex-direction: row; align-items: center; justify-content: flex-end; margin-top: 4px; }
.primary-action { min-width: 170px; min-height: 38px; background-color: #c8a77a; color: #151b24; border-width: 1px; border-color: var(--gold); border-bottom-width: 2px; border-radius: 0; font-size: 15px; -unity-font-style: bold; }
.primary-action:hover, .primary-action:focus { background-color: #e2c59c; color: #151b24; }
.primary-action:active { background-color: #b68e62; }
.primary-action:disabled { background-color: var(--inner); color: var(--muted); border-color: var(--line); }
.empty-state { align-items: center; justify-content: center; padding: 27px; border-width: 1px; border-color: var(--line); background-color: var(--inner); }
.empty-icon { width: 58px; height: 58px; margin-bottom: 11px; }
.empty-text { font-size: 17px; color: var(--muted); white-space: normal; -unity-text-align: middle-center; }
.product-grid { flex-direction: row; width: 100%; }
.pixel-row, .action-bar, .primary-action, .row-action, .product-grid { flex-shrink: 0; }
.product-card { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; background-color: var(--inner); border-width: 1px; border-color: var(--line); padding: 12px; align-items: center; margin-left: 7px; margin-right: 7px; }
.row-main, .row-title, .row-detail, .pixel-row { -unity-text-align: middle-left; }
.product-art { width: 128px; height: 128px; background-color: #262c39; border-width: 1px; border-color: var(--bronze); margin-bottom: 8px; }
.product-name { font-size: 18px; color: var(--paper); }
.product-copy { font-size: 14px; color: var(--muted); white-space: normal; -unity-text-align: middle-center; margin: 6px 0 8px; min-height: 43px; }
.nest-layout { flex-direction: row; height: 322px; flex-shrink: 0; background-color: var(--inner); border-width: 1px; border-color: var(--line); margin-bottom: 8px; }
.nest-chamber { position: relative; width: 320px; height: 316px; flex-shrink: 0; background-color: var(--space); border-right-width: 1px; border-color: var(--bronze); }
.nest-hero { position: absolute; left: 42px; top: 46px; width: 236px; height: 218px; background-color: rgba(0,0,0,0); }
.chamber-index { position: absolute; left: 65px; top: 28px; width: 150px; font-size: 13px; color: var(--space); -unity-text-align: middle-left; }
.chamber-seal { position: absolute; left: 91px; bottom: 23px; width: 140px; font-size: 12px; color: var(--paper); -unity-text-align: middle-center; }
.nest-info { flex-grow: 1; flex-shrink: 1; min-width: 0; padding: 18px 22px; justify-content: center; }
.nest-state { font-size: 23px; color: var(--paper); margin-top: 10px; margin-bottom: 7px; }
.nest-description { font-size: 16px; color: var(--muted); white-space: normal; min-height: 42px; margin-bottom: 9px; }
.nest-telemetry { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 29px; border-top-width: 1px; border-bottom-width: 1px; border-color: var(--line); margin-bottom: 12px; }
.telemetry-value { font-size: 12px; color: var(--muted); margin: 0 16px 0 0; }
.progress-label { font-size: 12px; color: var(--muted); margin-bottom: 6px; }
.progress-track { flex-direction: row; height: 16px; flex-shrink: 0; background-color: var(--space); border-width: 1px; border-color: var(--line); padding: 2px; margin-bottom: 14px; }
.progress-segment { flex-grow: 1; flex-basis: 0; height: 100%; margin-right: 2px; background-color: var(--line); opacity: 0.38; }
.progress-segment.is-filled { background-color: var(--jade); opacity: 1; }
.progress-track.is-ready .progress-segment.is-filled { background-color: var(--gold); }
.nest-action { align-self: stretch; min-width: 190px; min-height: 39px; font-size: 15px; }
.nest-waiting { min-height: 43px; padding: 8px; background-color: var(--space); color: var(--jade); border-width: 1px; border-color: var(--line); -unity-text-align: middle-center; flex-shrink: 0; font-size: 15px; }
.nest-note { font-size: 15px; margin-bottom: 0; }
.toast { position: absolute; left: 50%; bottom: 53px; width: 470px; margin-left: -235px; background-color: var(--space); border-width: 1px; border-color: var(--bronze); padding: 11px 16px; }
.toast-label { font-size: 16px; -unity-text-align: middle-center; white-space: normal; }

.party-button { height: 42px; min-width: 85px; background-color: var(--panel); color: var(--paper); font-size: 17px; border-radius: 0; border-width: 1px; border-color: var(--bronze); margin: 0 8px 0 0; }
.party-button:hover, .party-button:focus { border-color: var(--gold); }
.party-tag { position: absolute; width: 68px; height: 21px; background-color: rgba(15,28,38,0.88); color: #e8d8b7; font-size: 13px; -unity-text-align: middle-center; border-bottom-width: 1px; border-color: #b69467; }
.party-field { height: 36px; margin-bottom: 10px; font-size: 17px; }
.party-field > .unity-text-field__input { background-color: var(--inner); color: var(--paper); }
.party-status { font-size: 18px; color: var(--gold); margin-top: 8px; margin-bottom: 9px; white-space: normal; }
.party-tag.map-tag { width: 20px; height: 18px; font-size: 12px; border-color: #86b3b0; }
