<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="Hub.uss" />
  <ui:VisualElement name="hubRoot" class="hub-root body-font">
    <ui:VisualElement name="worldHud" class="full">
      <ui:VisualElement class="top-hud">
        <ui:VisualElement class="brand">
          <ui:VisualElement name="brandGlyph" class="brand-mark" />
          <ui:VisualElement>
            <ui:Label text="Lumon" class="brand-name display-title" />
            <ui:Label text="OBSERVATÓRIO" class="brand-sub" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="hud-right">
          <ui:Button name="partyButton" text="Grupo" class="party-button" />
          <ui:VisualElement class="currency">
            <ui:VisualElement name="coinGlyph" class="currency-glyph" />
            <ui:Label name="coinLabel" text="150" class="currency-text" />
          </ui:VisualElement>
          <ui:Button name="settingsButton" class="icon-button" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="markerLayer" class="marker-layer">
        <ui:Button name="markerWestScope" class="station-marker"><ui:VisualElement class="marker-glyph" /><ui:Label text="LIRA" class="marker-label" /></ui:Button>
        <ui:Button name="markerEastScope" class="station-marker"><ui:VisualElement class="marker-glyph" /><ui:Label text="CISNE" class="marker-label" /></ui:Button>
        <ui:Button name="markerTeam" class="station-marker"><ui:VisualElement class="marker-glyph" /><ui:Label text="EQUIPE" class="marker-label pixel-title" /></ui:Button>
        <ui:Button name="markerNest" class="station-marker"><ui:VisualElement class="marker-glyph" /><ui:Label text="NINHO" class="marker-label pixel-title" /></ui:Button>
        <ui:Button name="markerEggShop" class="station-marker"><ui:VisualElement class="marker-glyph" /><ui:Label text="OVOS" class="marker-label pixel-title" /></ui:Button>
        <ui:Button name="markerFusion" class="station-marker"><ui:VisualElement class="marker-glyph" /><ui:Label text="FUSÃO" class="marker-label pixel-title" /></ui:Button>
        <ui:Button name="markerImprove" class="station-marker"><ui:VisualElement class="marker-glyph" /><ui:Label text="MELHORAR" class="marker-label pixel-title" /></ui:Button>
        <ui:Button name="markerExpeditions" class="station-marker"><ui:VisualElement class="marker-glyph" /><ui:Label text="EXPEDIÇÃO" class="marker-label pixel-title" /></ui:Button>
      </ui:VisualElement>
      <ui:VisualElement name="interactionPrompt" class="prompt is-hidden">
        <ui:Label text="E" class="key pixel-title" />
        <ui:Label name="promptLabel" text="Entrar na Equipe" class="prompt-text" />
      </ui:VisualElement>
      <ui:Label text="WASD  Mover    ·    Q / R  Girar    ·    V  Mapa    ·    E  Interagir" class="controls" />
    </ui:VisualElement>

    <ui:VisualElement name="modalHost" class="modal-host is-hidden">
      <ui:VisualElement class="modal-shade" />
      <ui:VisualElement name="panelShadow" class="panel-shadow">
        <ui:VisualElement class="station-panel">
          <ui:VisualElement class="station-header">
            <ui:VisualElement name="stationEmblem" class="station-emblem" />
            <ui:VisualElement>
              <ui:Label name="stationKicker" text="ESTAÇÃO DO SANTUÁRIO" class="station-kicker" />
              <ui:Label name="stationTitle" text="Equipe" class="station-title display-title" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:Button name="closeButton" text="×" class="close-button pixel-title" />
          <ui:ScrollView name="stationScroll" class="station-scroll"><ui:VisualElement name="stationBody" class="station-body" /></ui:ScrollView>
          <ui:VisualElement class="station-footer"><ui:Label name="stationHint" text="ESC para voltar ao santuário" class="station-hint" /></ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="toast" class="toast is-hidden"><ui:Label name="toastLabel" class="toast-label" /></ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
